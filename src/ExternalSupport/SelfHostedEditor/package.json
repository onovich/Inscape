{
  "name": "inscape-self-hosted-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "Desktop/ElectronMain.js",
  "license": "UNLICENSED",
  "description": "First-party Inscape authoring client shell.",
  "scripts": {
    "check:model": "node DevScripts/SelfHostedEditorModelContractSuite.js",
    "check:backend-services": "node DevScripts/SelfHostedEditorBackendServiceContractCheck.js",
    "check:backend-transport": "node DevScripts/SelfHostedEditorBackendTransportContractCheck.js",
    "check:fake-embedded-transport": "node DevScripts/SelfHostedEditorFakeEmbeddedTransportContractCheck.js",
    "check:preload-transport": "node DevScripts/SelfHostedEditorPreloadTransportContractCheck.js",
    "check:http-bridge": "node DevScripts/SelfHostedEditorHttpBridgeContractCheck.js",
    "check:payload-bridge": "node DevScripts/SelfHostedEditorPayloadBridgeContractCheck.js",
    "check:process-bridge": "node DevScripts/SelfHostedEditorProcessBridgeContractCheck.js",
    "check:desktop-package": "node DevScripts/SelfHostedEditorDesktopPackageContractCheck.js",
    "check:desktop-backend": "node DevScripts/SelfHostedEditorDesktopBackendContractCheck.js",
    "check:workspace-fs": "node DevScripts/SelfHostedEditorWorkspaceFileSystemContractCheck.js",
    "check:electron-boundary": "node DevScripts/SelfHostedEditorElectronBoundaryContractCheck.js",
    "check:electron-ipc": "node DevScripts/SelfHostedEditorElectronIpcContractCheck.js",
    "check:electron-language-artifact": "node DevScripts/SelfHostedEditorElectronLanguageArtifactContractCheck.js",
    "check:electron-language-session": "node DevScripts/SelfHostedEditorElectronLanguageSessionContractCheck.js",
    "check:electron-lifecycle": "node DevScripts/SelfHostedEditorElectronLifecycleContractCheck.js",
    "check:electron-workspace": "node DevScripts/SelfHostedEditorElectronWorkspaceContractCheck.js",
    "check:electron-shell": "node DevScripts/SelfHostedEditorElectronShellContractCheck.js",
    "check:static-assets": "node DevScripts/SelfHostedEditorStaticAssetBridgeContractCheck.js",
    "check:static-assets-http": "node DevScripts/SelfHostedEditorStaticAssetHttpSmoke.js",
    "check:session-cache": "node DevScripts/SelfHostedEditorSessionCacheContractCheck.js",
    "check:session-cache-http": "node DevScripts/SelfHostedEditorSessionCacheHttpSmoke.js",
    "check:language-session": "node DevScripts/SelfHostedEditorLanguageSessionBridgeContractCheck.js",
    "check:host-binding-http": "node DevScripts/SelfHostedEditorHostBindingHttpSmoke.js",
    "check:host-binding": "node DevScripts/SelfHostedEditorHostBindingSmoke.js",
    "check:host-schema-http": "node DevScripts/SelfHostedEditorHostSchemaHttpSmoke.js",
    "check:host-schema": "node DevScripts/SelfHostedEditorHostSchemaSmoke.js",
    "check:line-map-http": "node DevScripts/SelfHostedEditorLineMapHttpSmoke.js",
    "check:line-map": "node DevScripts/SelfHostedEditorLineMapSmoke.js",
    "check:localization-update-http": "node DevScripts/SelfHostedEditorLocalizationUpdateHttpSmoke.js",
    "check:localization-update": "node DevScripts/SelfHostedEditorLocalizationUpdateSmoke.js",
    "check:localization-review-http": "node DevScripts/SelfHostedEditorLocalizationReviewHttpSmoke.js",
    "check:localization-review": "node DevScripts/SelfHostedEditorLocalizationReviewSmoke.js",
    "check:runtime-http": "node DevScripts/SelfHostedEditorRuntimeHttpSmoke.js",
    "check:runtime": "node DevScripts/SelfHostedEditorRuntimeSmoke.js",
    "check:semantic-parity-http": "node DevScripts/SelfHostedEditorSemanticParityHttpSmoke.js",
    "check:references-http": "node DevScripts/SelfHostedEditorReferencesHttpSmoke.js",
    "check:references": "node DevScripts/SelfHostedEditorReferencesSmoke.js",
    "check:node-map-http": "node DevScripts/SelfHostedEditorStoryNodeMapHttpSmoke.js",
    "check:node-map": "node DevScripts/SelfHostedEditorStoryNodeMapSmoke.js",
    "check:style-structure": "node DevScripts/SelfHostedEditorStyleStructureContractCheck.js",
    "check:structure": "node DevScripts/SelfHostedEditorStructureContractCheck.js && node DevScripts/SelfHostedEditorStyleStructureContractCheck.js",
    "check:syntax": "node DevScripts/SelfHostedEditorSyntaxContractCheck.js",
    "smoke:desktop": "node DevScripts/SelfHostedEditorDesktopV0Smoke.js",
    "smoke:desktop-gui-recovery": "node DevScripts/SelfHostedEditorDesktopGuiRecoverySmoke.js",
    "smoke:desktop-package": "node DevScripts/SelfHostedEditorDesktopPackageSmoke.js",
    "smoke:desktop-package-gui": "node DevScripts/SelfHostedEditorDesktopPackageGuiSmoke.js",
    "smoke:desktop-package-language": "node DevScripts/SelfHostedEditorDesktopPackageLanguageSmoke.js",
    "smoke:desktop-runtime": "node DevScripts/SelfHostedEditorDesktopRuntimeSmoke.js",
    "smoke:desktop-startup": "node DevScripts/SelfHostedEditorDesktopStartupSmoke.js",
    "package:windows": "electron-builder --win dir --x64",
    "start:desktop": "electron Desktop/ElectronMain.js",
    "start": "node DevScripts/StartSelfHostedEditorPreview.js"
  },
  "dependencies": {
    "monaco-editor": "^0.55.1"
  },
  "overrides": {
    "dompurify": "3.4.10"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.inscape.self-hosted-editor",
    "productName": "Inscape SelfHostedEditor",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "42.4.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "Desktop/**/*",
      "Resources/**/*",
      "Scripts/**/*",
      "package.json",
      "node_modules/monaco-editor/**/*"
    ],
    "extraResources": [
      {
        "from": "../../../samples",
        "to": "samples",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../../src/Internal/LanguageServer/bin/Debug/net10.0",
        "to": "language-server",
        "filter": [
          "Inscape.Compiler.dll",
          "Inscape.LanguageServer.deps.json",
          "Inscape.LanguageServer.dll",
          "Inscape.LanguageServer.exe",
          "Inscape.LanguageServer.runtimeconfig.json",
          "Inscape.Tooling.dll",
          "Resources/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
